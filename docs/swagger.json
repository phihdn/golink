{
    "swagger": "2.0",
    "info": {
        "description": "URL shortener service.",
        "title": "golink API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health-check": {
            "get": {
                "description": "Returns the service name and instance id. Returns 500 when Redis does not answer a ping.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Health"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/gen-pass": {
            "get": {
                "description": "Returns a random 10-character alphanumeric password as plain text.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "password"
                ],
                "summary": "Generate a password",
                "responses": {
                    "200": {
                        "description": "aB3dE6gH9j",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/links/shorten": {
            "post": {
                "description": "Generate a unique 7-character code for the url. exp is the lifetime in seconds, 0 or omitted means no expiration.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "link"
                ],
                "summary": "Generate shorten url based on original url",
                "parameters": [
                    {
                        "description": "Input required",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.shortenLinkInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.shortenLinkResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.shortenLinkInput": {
            "type": "object",
            "required": [
                "url"
            ],
            "properties": {
                "exp": {
                    "description": "Exp is the link lifetime in seconds, at most 7 days (604800).\n0 or omitted means the link never expires.",
                    "type": "integer",
                    "maximum": 604800,
                    "minimum": 0,
                    "example": 604800
                },
                "url": {
                    "type": "string",
                    "example": "https://example.com/some/long/path"
                }
            }
        },
        "handler.shortenLinkResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "aB3dE6g"
                },
                "message": {
                    "type": "string",
                    "example": "Shorten URL generated successfully!"
                }
            }
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Internal Server Error"
                }
            }
        },
        "model.Health": {
            "type": "object",
            "properties": {
                "instance_id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "service_name": {
                    "type": "string"
                }
            }
        }
    }
}